<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ad-Hash Projects Status Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .header {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header h1 {
            font-size: 32px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header .subtitle {
            color: #666;
            font-size: 14px;
            margin-top: 5px;
        }

        .run-button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 15px 40px;
            font-size: 18px;
            border-radius: 10px;
            cursor: pointer;
            transition: transform 0.2s;
            font-weight: bold;
        }

        .run-button:hover:not(:disabled) {
            transform: scale(1.05);
        }

        .run-button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .summary-tiles {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .tile {
            background: white;
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .tile .value {
            font-size: 48px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .tile .label {
            color: #666;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .tile.total .value { color: #667eea; }
        .tile.passed .value { color: #10b981; }
        .tile.failed .value { color: #ef4444; }
        .tile.duration .value { color: #3b82f6; }

        .status-banner {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 20px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .status-banner.error {
            background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);
        }

        .test-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 20px;
            font-weight: bold;
            color: #333;
        }

        .section-icon {
            font-size: 24px;
        }

        .status-badge {
            padding: 8px 20px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: bold;
        }

        .status-badge.passed {
            background: #d1fae5;
            color: #065f46;
        }

        .status-badge.failed {
            background: #fee2e2;
            color: #991b1b;
        }

        .status-badge.running {
            background: #dbeafe;
            color: #1e40af;
        }

        .status-badge.not-run {
            background: #f3f4f6;
            color: #6b7280;
        }

        .stats-row {
            display: none; /* Hidden by default */
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }

        .stats-row.visible {
            display: flex;
        }

        .stat-badge {
            padding: 8px 15px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
        }

        .stat-badge.total { background: #e0e7ff; color: #3730a3; }
        .stat-badge.passed { background: #d1fae5; color: #065f46; }
        .stat-badge.failed { background: #fee2e2; color: #991b1b; }
        .stat-badge.warning { background: #fef3c7; color: #92400e; }
        .stat-badge.ok { background: #d1fae5; color: #065f46; }

        .view-details-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            transition: all 0.3s;
            display: none; /* Hidden by default */
        }

        .view-details-btn.visible {
            display: inline-block;
        }

        .view-details-btn:hover {
            transform: scale(1.05);
        }

        .view-details-btn .arrow {
            margin-left: 5px;
            transition: transform 0.3s;
        }

        .view-details-btn.expanded .arrow {
            transform: rotate(180deg);
        }

        .report-container {
            display: none;
            margin-top: 20px;
            border-top: 2px solid #e5e7eb;
            padding-top: 20px;
        }

        .report-container.expanded {
            display: block;
        }

        .report-iframe {
            width: 100%;
            height: 600px;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
        }

        .console-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-top: 20px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .console-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
            font-size: 18px;
            font-weight: bold;
            color: #333;
        }

        .console-output {
            background: #1e1e1e;
            color: #d4d4d4;
            padding: 20px;
            border-radius: 10px;
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: 13px;
            max-height: 300px;
            overflow-y: auto;
            line-height: 1.6;
        }

        .console-line {
            margin-bottom: 5px;
        }

        .console-line.info { color: #4fc3f7; }
        .console-line.success { color: #66bb6a; }
        .console-line.error { color: #ef5350; }
        .console-line.warning { color: #ffb74d; }

        @media (max-width: 768px) {
            .summary-tiles {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>

</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div>
                <h1>🚀 Ad-Hash Projects Status Dashboard</h1>
                <div class="subtitle">Unified Test Execution & Monitoring</div>
            </div>
            <button class="run-button" id="runButton" onclick="runAllTests()">▶ Run All Tests</button>
        </div>

        <!-- Summary Tiles -->
        <div class="summary-tiles">
            <div class="tile total">
                <div class="value" id="totalTests">0</div>
                <div class="label">Total Tests</div>
            </div>
            <div class="tile passed">
                <div class="value" id="passedTests">0</div>
                <div class="label">Passed</div>
            </div>
            <div class="tile failed">
                <div class="value" id="failedTests">0</div>
                <div class="label">Failed</div>
            </div>
            <div class="tile duration">
                <div class="value" id="duration">0s</div>
                <div class="label">Duration</div>
            </div>
        </div>



        <!-- Test Sections -->
        <div id="testSections">
            <!-- Server Health Monitoring -->
            <div class="test-section" id="section-server">
                <div class="section-header">
                    <div class="section-title">
                        <span class="section-icon">🖥️</span>
                        <span>Server Health Monitoring</span>
                    </div>
                    <span class="status-badge not-run" id="status-server">Not Run</span>
                </div>
                <div class="stats-row" id="stats-server">
                    <span class="stat-badge total">Total: 0</span>
                    <span class="stat-badge passed">Passed: 0</span>
                    <span class="stat-badge failed">Failed: 0</span>
                    <span class="stat-badge ok">OK: 0</span>
                </div>
                <button class="view-details-btn" id="btn-server" onclick="toggleReport('server')">
                    View Details <span class="arrow">▼</span>
                </button>
                <div class="report-container" id="report-server">
                    <iframe class="report-iframe" id="iframe-server" title="Server Health Report"></iframe>
                </div>
            </div>

            <!-- SSL Certificate Monitoring -->
            <div class="test-section" id="section-cert">
                <div class="section-header">
                    <div class="section-title">
                        <span class="section-icon">🔒</span>
                        <span>SSL Certificate Monitoring</span>
                    </div>
                    <span class="status-badge not-run" id="status-cert">Not Run</span>
                </div>
                <div class="stats-row" id="stats-cert">
                    <span class="stat-badge total">Total: 0</span>
                    <span class="stat-badge passed">Passed: 0</span>
                    <span class="stat-badge warning">Warning: 0</span>
                    <span class="stat-badge ok">OK: 0</span>
                </div>
                <button class="view-details-btn" id="btn-cert" onclick="toggleReport('cert')">
                    View Details <span class="arrow">▼</span>
                </button>
                <div class="report-container" id="report-cert">
                    <iframe class="report-iframe" id="iframe-cert" title="SSL Certificate Report"></iframe>
                </div>
            </div>

            <!-- API Endpoint Testing -->
            <div class="test-section" id="section-api">
                <div class="section-header">
                    <div class="section-title">
                        <span class="section-icon">🌐</span>
                        <span>API Endpoint Testing</span>
                    </div>
                    <span class="status-badge not-run" id="status-api">Not Run</span>
                </div>
                <div class="stats-row" id="stats-api">
                    <span class="stat-badge total">Total: 0</span>
                </div>
                <button class="view-details-btn" id="btn-api" onclick="toggleReport('api')">
                    View Details <span class="arrow">▼</span>
                </button>
                <div class="report-container" id="report-api">
                    <iframe class="report-iframe" id="iframe-api" title="API Endpoint Report"></iframe>
                </div>
            </div>

            <!-- App Status Verification -->
            <div class="test-section" id="section-app">
                <div class="section-header">
                    <div class="section-title">
                        <span class="section-icon">📱</span>
                        <span>App Status Verification</span>
                    </div>
                    <span class="status-badge not-run" id="status-app">Not Run</span>
                </div>
                <div class="stats-row" id="stats-app">
                    <span class="stat-badge total">Total: 0</span>
                    <span class="stat-badge passed">Passed: 0</span>
                </div>
                <button class="view-details-btn" id="btn-app" onclick="toggleReport('app')">
                    View Details <span class="arrow">▼</span>
                </button>
                <div class="report-container" id="report-app">
                    <iframe class="report-iframe" id="iframe-app" title="App Status Report"></iframe>
                </div>
            </div>
        </div>

        <!-- Console Output -->
        <div class="console-section">
            <div class="console-header">
                <span>📟</span>
                <span>Console Output</span>
            </div>
            <div class="console-output" id="consoleOutput">
                <div class="console-line info">[INFO] Dashboard loaded. Ready to run tests.</div>
            </div>
        </div>
    </div>

    <script>
        let testRunning = false;

        function addConsoleLog(message, type = 'info') {
            const console = document.getElementById('consoleOutput');
            const timestamp = new Date().toLocaleTimeString();
            const line = document.createElement('div');
            line.className = `console-line ${type}`;
            line.textContent = `[${timestamp}] ${message}`;
            console.appendChild(line);
            console.scrollTop = console.scrollHeight;
        }

        function toggleReport(section) {
            const reportContainer = document.getElementById(`report-${section}`);
            const iframe = document.getElementById(`iframe-${section}`);
            const button = document.getElementById(`btn-${section}`);

            if (reportContainer.classList.contains('expanded')) {
                reportContainer.classList.remove('expanded');
                button.classList.remove('expanded');
            } else {
                reportContainer.classList.add('expanded');
                button.classList.add('expanded');

                // Load report if not already loaded
                if (!iframe.src) {
                    const reportUrls = {
                        'server': '/reports/server-health/index.html',
                        'cert': '/reports/certificates/index.html',
                        'api': '/reports/api/index.html',
                        'app': '/reports/app-status/index.html'
                    };
                    iframe.src = reportUrls[section];
                    addConsoleLog(`Loading ${section} report...`, 'info');
                }
            }
        }

        async function runAllTests() {
            if (testRunning) return;

            testRunning = true;
            const runButton = document.getElementById('runButton');
            runButton.disabled = true;
            runButton.textContent = '⏳ Running Tests...';

            addConsoleLog('Starting test execution...', 'info');

            try {
                // Trigger test execution
                const response = await fetch('/api/run-tests', { method: 'POST' });
                const data = await response.json();

                if (data.status === 'started') {
                    addConsoleLog('Tests started successfully', 'success');

                    // Poll for results
                    pollTestResults();
                }
            } catch (error) {
                addConsoleLog(`Error: ${error.message}`, 'error');
                runButton.disabled = false;
                runButton.textContent = '▶ Run All Tests';
                testRunning = false;
            }
        }

        async function pollTestResults() {
            const maxAttempts = 60; // Poll for up to 5 minutes
            let attempts = 0;

            const interval = setInterval(async () => {
                attempts++;

                try {
                    const response = await fetch('/api/test-status');
                    const data = await response.json();

                    if (data.status === 'completed') {
                        clearInterval(interval);
                        updateDashboard(data.results);
                        testRunning = false;
                        const runButton = document.getElementById('runButton');
                        runButton.disabled = false;
                        runButton.textContent = '▶ Run All Tests';
                        addConsoleLog('All tests completed!', 'success');
                    } else if (data.status === 'running') {
                        addConsoleLog(`Running: ${data.currentSection}...`, 'info');
                        updateSectionStatus(data.currentSection, 'running');
                    }

                    if (attempts >= maxAttempts) {
                        clearInterval(interval);
                        addConsoleLog('Test execution timeout', 'error');
                        testRunning = false;
                        const runButton = document.getElementById('runButton');
                        runButton.disabled = false;
                        runButton.textContent = '▶ Run All Tests';
                    }
                } catch (error) {
                    console.error('Polling error:', error);
                }
            }, 5000); // Poll every 5 seconds
        }

        function updateSectionStatus(section, status) {
            const statusBadge = document.getElementById(`status-${section}`);
            if (statusBadge) {
                statusBadge.textContent = status === 'running' ? 'Running...' : status;
                statusBadge.className = `status-badge ${status}`;
            }
        }

        function updateDashboard(results) {
            // Update summary tiles
            document.getElementById('totalTests').textContent = results.totalTests || 0;
            document.getElementById('passedTests').textContent = results.passed || 0;
            document.getElementById('failedTests').textContent = results.failed || 0;
            document.getElementById('duration').textContent = results.duration || '0s';

            // Update sections
            if (results.sections) {
                updateSection('server', results.sections.serverHealth);
                updateSection('cert', results.sections.sslCertificate);
                updateSection('api', results.sections.apiEndpoint);
                updateSection('app', results.sections.appStatus);
            }
        }

        function updateSection(sectionId, data) {
            if (!data) return;

            const statusBadge = document.getElementById(`status-${sectionId}`);
            const statsRow = document.getElementById(`stats-${sectionId}`);
            const viewButton = document.getElementById(`btn-${sectionId}`);

            // Update status badge
            const status = data.failed > 0 ? 'failed' : 'passed';
            statusBadge.textContent = data.status || (data.failed > 0 ? 'Failed' : 'Passed');
            statusBadge.className = `status-badge ${status}`;

            // Show stats row
            statsRow.classList.add('visible');

            // Update stats
            const badges = statsRow.querySelectorAll('.stat-badge');
            badges.forEach(badge => {
                const text = badge.textContent;
                if (text.includes('Total:')) {
                    badge.textContent = `Total: ${data.total || 0}`;
                } else if (text.includes('Passed:')) {
                    badge.textContent = `Passed: ${data.passed || 0}`;
                } else if (text.includes('Failed:')) {
                    badge.textContent = `Failed: ${data.failed || 0}`;
                } else if (text.includes('Warning:')) {
                    badge.textContent = `Warning: ${data.warning || 0}`;
                } else if (text.includes('OK:')) {
                    badge.textContent = `OK: ${data.ok || data.passed || 0}`;
                }
            });

            // Show View Details button
            viewButton.classList.add('visible');
        }

        // Don't load previous results automatically - only show after user clicks Run
        window.addEventListener('load', async () => {
            addConsoleLog('Dashboard ready. Click "Run All Tests" to start.', 'info');
        });
    </script>
</body>
</html>