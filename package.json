{
  "name": "adhash-dashboard",
  "version": "1.0.0",
  "description": "AdHash Projects Status Dashboard - Unified Test Execution & Monitoring",
  "main": "server.js",
  "scripts": {
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "clean:workflow": "node -e \"const fs=require('fs');['suite-reports','test-results','unified-dashboard','final-dashboard-bundle','email-preview'].forEach((target)=>fs.rmSync(target,{recursive:true,force:true}));\"",
    "start": "node server.js",
    "dev": "node server.js",
    "test:api": "playwright test tests/api/api-tests.spec.ts",
    "test:all": "ts-node run-all-tests.ts",
    "generate:dashboard": "ts-node regenerate-dashboard.ts",
    "workflow:email": "npm run clean:workflow && npm run test:api && ts-node run-all-tests.ts --skip-clean && ts-node regenerate-dashboard.ts",
    "validate-report": "ts-node validate-report.ts",
    "validate:report": "node scripts/validate-report-consistency.mjs",
    "regenerate:specs": "node scripts/regenerate-specs.mjs",
    "push:specs": "node scripts/push-specs-to-github.mjs",
    "qa:enterprise": "npm run regenerate:specs && node scripts/run-enterprise-qa-pipeline.mjs"
  },
  "keywords": [
    "dashboard",
    "testing",
    "monitoring",
    "playwright"
  ],
  "author": "AdHash Team",
  "license": "ISC",
  "dependencies": {
    "@types/nodemailer": "^7.0.9",
    "@types/node": "^20.11.0",
    "axios": "^1.13.4",
    "dotenv": "^17.2.4",
    "express": "^4.18.2",
    "nodemailer": "^8.0.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0"
  }
}
